<resources>
    <style name="Theme.FocusGarden" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#7FA47B</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.FocusGarden.Timer" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Animation.FocusGarden.BottomSheet" parent="">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
    <style name="Animation.FocusGarden.RightSheet" parent="">
        <item name="android:windowEnterAnimation">@anim/right_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/right_sheet_exit</item>
    </style>
</resources>
